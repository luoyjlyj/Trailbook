{
  "name": "@trailbook/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local Trailbook API: health check and travel request validation only.",
  "engines": { "node": ">=24.3.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "6.0.3"
  }
}
